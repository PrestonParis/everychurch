# Copy to .env and fill in real values. Never commit .env.
#
# Local dev (matches docker-compose.yml defaults):
DATABASE_URL=jdbc:postgresql://localhost:5432/everychurch
DATABASE_USERNAME=everychurch
DATABASE_PASSWORD=everychurch

# Hosted (Neon) example — get the real values from the Neon console, not from git history:
# DATABASE_URL=jdbc:postgresql://<your-neon-host>/neondb?sslmode=require
# DATABASE_USERNAME=<your-neon-username>
# DATABASE_PASSWORD=<your-neon-password>

# JWT signing secret (HS256 needs >= 32 bytes). Generate with: openssl rand -base64 48
# The value in application.properties is a dev-only fallback — always set this for
# real environments.
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef
JWT_EXPIRATION_MS=86400000

# Seeds one Platform Admin user on startup if none exists yet (see AdminUserSeeder).
# Change the password before deploying anywhere real.
ADMIN_EMAIL=admin@everychurch.local
ADMIN_PASSWORD=change-me-now

# apps/scraper (see docs/SCRAPER.md) — not read by the server.
GOOGLE_PLACES_API_KEY=
# Shared secret the scraper sends as `X-Scraper-Api-Key` when submitting to the
# server's ingestion endpoint (service-to-service auth, not a user JWT).
SCRAPER_API_KEY=dev-only-insecure-scraper-key-change-me
SERVER_BASE_URL=http://localhost:8080
SCRAPER_SEARCH_RADIUS_M=25000

# apps/scraper/scraper/bulk_import.py (Prompt 7) — a one-time/occasional bulk seed
# from the Kaggle "us-places-of-worship" dataset, NOT part of the recurring scraper
# pipeline. Uses its OWN separate key, independently revocable from SCRAPER_API_KEY,
# since it writes Church rows directly rather than through the review queue.
BULK_IMPORT_API_KEY=dev-only-insecure-bulk-import-key-change-me
# Kaggle auth for kagglehub — this specific dataset is public and downloaded fine
# without it in testing, but set these if a download ever fails asking for auth.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Google Geocoding API key, used to derive a church's lat/lng from its address
# (see docs/ARCHITECTURE.md "Geocoding"). Leave blank in dev to skip geocoding.
GOOGLE_GEOCODING_API_KEY=

# Base URL of the Angular client (no trailing slash) — used to build absolute
# redirect targets, e.g. the volunteer field-kit's /r/nearest short link.
CLIENT_BASE_URL=http://localhost:4200

# Forgot/reset password emails (SmtpMailService). Leave MAIL_HOST blank in dev to
# skip sending real email — the reset link is logged server-side instead, so the
# flow still works locally without any SMTP setup. Any SMTP provider works: SES's
# SMTP interface, SendGrid, Mailtrap (good for local testing), Gmail with an app
# password, etc.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@everychurch.local

# S3-backed image/sermon uploads (see docs/ARCHITECTURE.md "Object Storage"). Leave
# S3_BUCKET_NAME blank in dev to disable uploads (a clear error, not a crash).
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY are read via the AWS SDK's own default
# credentials chain, not custom app properties — set them the normal AWS way
# (env vars here, or `aws configure`, or an instance profile in real deployments).
S3_BUCKET_NAME=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Maps Embed API key, shown on a church profile's map card (see
# ChurchMapComponent). Safe to expose to the browser — restrict it by HTTP referrer
# in Google Cloud Console, not by secrecy — served via GET /api/config rather than
# baked into the Angular build. Leave blank to hide the embed; the "Get Directions"
# link still works with no key at all. Use a SEPARATE key from
# GOOGLE_GEOCODING_API_KEY above, restricted to only the Maps Embed API, since this
# one is public and that one isn't.
GOOGLE_MAPS_EMBED_API_KEY=
